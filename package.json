{
  "name": "antigravity-context-viewer",
  "version": "0.8.8",
  "displayVersion": "0.8.8 α",
  "description": "Antigravity 桌面客户端的对话上下文、生成速度与 Token 用量看板",
  "main": "cli.js",
  "bin": {
    "antigravity-context-viewer": "./cli.js",
    "antigravity-meter": "./cli.js"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "install-patch": "node cli.js install",
    "install-meter": "node cli.js install",
    "live": "node cli.js live",
    "status": "node cli.js status",
    "check": "node cli.js check",
    "restore": "node cli.js restore",
    "uninstall-patch": "node cli.js restore",
    "build:renderer": "node scripts/build-renderer.js",
    "pretest": "node scripts/build-renderer.js",
    "test": "node --test meter-core.test.js meter-renderer.test.js meter-quota.test.js meter-storage-proxy.test.js meter-subscription.test.js meter-integration.test.js meter-security-update.test.js meter-context-unlock.test.js meter-enhance.test.js meter-update-delivery.test.js meter-cli-launcher.test.js meter-v083-fixes.test.js meter-model-context-isolation.test.js meter-v085-fixes.test.js meter-hotload.test.js meter-macos-watch.test.js meter-v089-usage.test.js meter-elv91-speed.test.js meter-accounts.test.js",
    "format": "npx prettier --write \"*.js\" \"*.json\" \"*.md\"",
    "format:check": "npx prettier --check \"*.js\" \"*.json\" \"*.md\"",
    "pack": "node scripts/package-release.js",
    "package": "node scripts/package-release.js"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "context-viewer",
    "context-window",
    "token-meter",
    "token-tracker",
    "activity-heatmap",
    "progress-bar",
    "electron-patch",
    "gemini",
    "ai-agent"
  ],
